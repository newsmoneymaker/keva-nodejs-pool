[Unit]
Description=Kevacoin pool: block unlocker (credits the miners after the coinbase maturity)
After=keva-pool-redis.service keva-node.service keva-wallet-rpc.service
Requires=keva-pool-redis.service
[Service]
Type=simple
User=kevapool
WorkingDirectory=/opt/keva-nodejs-pool
ExecStart=/usr/bin/node /opt/keva-nodejs-pool/init.js -module=unlocker
Restart=always
RestartSec=15
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
