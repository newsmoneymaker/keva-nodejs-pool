[Unit]
Description=Kevacoin pool: public API (127.0.0.1:8118)
After=keva-pool-redis.service keva-node.service keva-wallet-rpc.service
Requires=keva-pool-redis.service
[Service]
Type=simple
User=kevapool
WorkingDirectory=/opt/keva-nodejs-pool
ExecStart=/usr/bin/node /opt/keva-nodejs-pool/init.js -module=api
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
